{
  "name": "retail-analytics-platform-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.ts --testPathIgnorePatterns=integration --watchAll=false",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:e2e": "jest --config ./test/e2e/jest-e2e.json",
    "seed:clear": "ts-node -r tsconfig-paths/register src/core/database/seeds/clear-db.seed.ts",
    "seed:default": "ts-node -r tsconfig-paths/register src/core/database/seeds/default-tenant.seed.ts",
    "seed:fake": "ts-node -r tsconfig-paths/register src/core/database/seeds/fake-data.seed.ts",
    "docker:build": "docker build -t retail-analytics-platform-backend .",
    "docker:run": "docker run -p 3000:3000 retail-analytics-platform-backend"
  },
  "dependencies": {
    "@langchain/community": "^1.0.4",
    "@langchain/core": "^1.1.31",
    "@langchain/groq": "^1.0.1",
    "@langchain/ollama": "^1.2.6",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.18",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.18",
    "bcryptjs": "^3.0.3",
    "chromadb": "^3.1.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "globals": "^17.1.0",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "pg": "^8.16.3",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.3.0",
    "@golevelup/nestjs-common": "^5.1.2",
    "@golevelup/nestjs-modules": "^1.1.2",
    "@golevelup/ts-jest": "^1.2.1",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@testcontainers/chromadb": "^11.13.0",
    "@testcontainers/minio": "^11.13.0",
    "@testcontainers/postgresql": "^11.13.0",
    "@testcontainers/redis": "^11.13.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "testcontainers": "^11.13.0",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "_moduleAliases": {
    "@/common": "./dist/common",
    "@/config": "./dist/config",
    "@/modules": "./dist/modules"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>",
      "test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/*.spec.ts",
      "!**/*.d.ts",
      "!**/*.integration.spec.ts",
      "!test/**",
      "!src/common/test-utils/**",
      "!src/modules/product/util/**",
      "!src/core/auth/types/**",
      "!src/common/types/**",
      "!src/database/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [],
    "moduleNameMapper": {
      "^@/core/(.*)$": "<rootDir>/src/core/$1",
      "^@/common/(.*)$": "<rootDir>/src/common/$1",
      "^@/modules/(.*)$": "<rootDir>/src/modules/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
