# Application
NODE_ENV=DEVELOPMENT
PORT=3000

# CORS
CORS_ORIGINS=http://localhost:5173

# Document Preprocessor Microservice
DOC_PREPROCESSOR_URL=http://localhost:4000
DOC_PREPROCESSOR_TIMEOUT_MS=30000
UPLOAD_MAX_MB=5

# Evotor Mock Integration
EVOTOR_PROVIDER=mock
EVOTOR_BASE_URL=http://localhost:3001
EVOTOR_TOKEN=mock-evotor-token

# JWT Authentication
JWT_SECRET=<Your JWT SHA-256 Secret key>
JWT_EXPIRED_TIME=1d

# Refresh Token
REFRESH_TOKEN_COOKIE=refreshToken
REFRESH_TOKEN_MAX_AGE=604800000

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<Your Redis password>

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
MEDIA_UPLOAD_PRESIGNED_TTL=900
CACHE_TTL=3600
WS_RATE_LIMIT_WINDOW=60
WS_RATE_LIMIT_MAX=20
CHAT_SESSION_TTL=1800

# Groq AI
GROQ_API_KEY=<Your GROQ API KEY>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7

# Ollama Embeddings
OLLAMA_BASE_URL=http://localhost:11435
EMBEDDINGS_MODEL=embeddinggemma

# ChromaDB Vector Store
VECTOR_COLLECTION_NAME=documents
CHROMADB_URL=http://localhost:8000

# PostgreSQL Database
DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/rag_database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<Your DB password>
DB_DATABASE=rag_database

# MinIO S3 Storage
S3_HOST=127.0.0.1
S3_PORT=9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_USERNAME=admin
S3_PASSWORD=<Your S3 password>
S3_BUCKET=rag-bucket
S3_REGION=us-east-1
S3_USE_SSL=false
